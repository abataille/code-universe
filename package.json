{
  "name": "code-universe",
  "version": "0.2.2",
  "description": "Local architecture and AI-agent review workspace for understanding unfamiliar codebases and verifying risky changes.",
  "private": true,
  "type": "module",
  "license": "BUSL-1.1",
  "author": "Dr. Raymund Vorwerk",
  "homepage": "https://www.vclab.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abataille/code-universe.git"
  },
  "bugs": {
    "url": "https://github.com/abataille/code-universe/issues"
  },
  "keywords": [
    "architecture",
    "code-analysis",
    "codex",
    "developer-tools",
    "mcp",
    "visualization"
  ],
  "scripts": {
    "start": "node server.js",
    "mcp": "node scripts/code-universe-mcp.js",
    "test:scan": "node scripts/test-scan-fixtures.js",
    "test:languages": "node scripts/test-language-adapters.js",
    "test:tree-sitter": "node scripts/test-tree-sitter-wasm.js",
    "test:visual": "node scripts/test-visual-regression.js",
    "test:license": "node scripts/test-license-entitlements.js",
    "license:keygen": "node scripts/generate-commercial-license-keys.js",
    "license:issue": "node scripts/issue-commercial-license.js",
    "check:repository": "node scripts/check-repository-policy.js",
    "test": "npm run test:scan && npm run test:languages && npm run test:tree-sitter && npm run test:visual && npm run test:review && npm run test:mcp && npm run test:license && npm run check:repository",
    "test:review": "node scripts/test-review-flow.js",
    "test:mcp": "node scripts/test-mcp.js",
    "scan:sample": "node scripts/scan-swift.js examples/SampleSwiftApp public/sample-graph.json",
    "scan:sample:swiftsyntax": "node scripts/scan-swift-syntax.js examples/SampleSwiftApp public/sample-graph.json",
    "review": "node scripts/code-universe-review.js",
    "mac:build": "swift build --package-path mac/CodeUniverseMac",
    "mac:run": "swift run --package-path mac/CodeUniverseMac CodeUniverseMac",
    "mac:bundle": "zsh scripts/build-electron-mac-app-bundle.sh",
    "mac:bundle:native": "zsh scripts/build-mac-app-bundle.sh",
    "mac:archive": "zsh scripts/build-electron-mac-app-bundle.sh",
    "mac:release": "zsh scripts/release-mac-app.sh",
    "mac:open": "npm run mac:bundle && open \"dist/Code Universe.app\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "parse5": "^8.0.1",
    "postcss": "^8.5.26",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "zod": "^4.5.4"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "fast-uri": "3.1.6",
    "hono": "4.13.5",
    "ip-address": "10.7.0",
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@electron/packager": "^20.1.1",
    "electron": "^43.3.0",
    "playwright-core": "^1.62.0"
  },
  "optionalDependencies": {
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.24.2",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.27.0"
  }
}
